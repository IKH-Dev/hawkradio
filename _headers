# ==============================================================================
# SUPER-OPTIMIZED CLOUDFLARE PAGES _headers CONFIGURATION
# ==============================================================================
# Platform Limits: Max 100 header rules | Max 2,000 characters per line
# Note: Applies exclusively to static assets served by Cloudflare Pages.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GLOBAL SECURITY & PERFORMANCE BASELINE
# ------------------------------------------------------------------------------
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), cross-origin-isolated=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  X-DNS-Prefetch-Control: on

# ------------------------------------------------------------------------------
# 2. HTML DOCUMENTS (INSTANT BROWSER REVALIDATION + FAST EDGE RESILIENCE)
# ------------------------------------------------------------------------------
/
  Cache-Control: public, max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: public, max-age=300, stale-while-revalidate=86400, stale-if-error=86400

/*.html
  Cache-Control: public, max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: public, max-age=300, stale-while-revalidate=86400, stale-if-error=86400

/404.html
  Cache-Control: public, max-age=60, must-revalidate
  Cloudflare-CDN-Cache-Control: public, max-age=300
  X-Robots-Tag: noindex, nofollow

# ------------------------------------------------------------------------------
# 3. IMMUTABLE FINGERPRINTED BUILD ASSETS (1-YEAR ZERO-REVALIDATION CACHE)
# ------------------------------------------------------------------------------
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/static/*
  Cache-Control: public, max-age=31536000, immutable

/build/*
  Cache-Control: public, max-age=31536000, immutable

# ------------------------------------------------------------------------------
# 4. WEB FONTS (1-YEAR IMMUTABLE CACHE + CORS ENABLED FOR PRELOADING)
# ------------------------------------------------------------------------------
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/*.woff
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

# ------------------------------------------------------------------------------
# 5. UNHASHED MEDIA & STATIC IMAGES (7-DAY BROWSER / 30-DAY EDGE CACHE)
# ------------------------------------------------------------------------------
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.avif
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; sandbox

/*.ico
  Cache-Control: public, max-age=2592000, immutable

# ------------------------------------------------------------------------------
# 6. SERVICE WORKERS & PWA MANIFESTS (STRICT FRESHNESS)
# ------------------------------------------------------------------------------
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: no-store
  Service-Worker-Allowed: /

/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: no-store
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate

/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate

# ------------------------------------------------------------------------------
# 7. SEO, CRAWLER & SECURITY METADATA FILES
# ------------------------------------------------------------------------------
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
  Cloudflare-CDN-Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
  Cloudflare-CDN-Cache-Control: public, max-age=86400

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# ------------------------------------------------------------------------------
# 8. PREVIEW DEPLOYMENT SEARCH ENGINE PROTECTION
# ------------------------------------------------------------------------------
https://*.pages.dev/*
  X-Robots-Tag: noindex, nofollow
